# ── Supabase (EU region — Central EU / Frankfurt) ─────────────────────────────
# Project Settings → API. The anon key is public (RLS protects data); the service role key is SECRET.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI coach (phase 7) ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Per-user daily limits while the coach is free (cost control)
COACH_DAILY_MESSAGE_LIMIT=40
COACH_DAILY_TOKEN_BUDGET=200000

# ── Billing (phase 8) — FREE_MODE=true unlocks everything and hides the paywall ─
FREE_MODE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# ── Affiliate partner programmes (query string assigned by each programme) ────
NEXT_PUBLIC_AFF_BRAINMARKET=
NEXT_PUBLIC_AFF_VILGAIN=

# ── Site ─────────────────────────────────────────────────────────────────────
# Optional: custom domain for canonical URLs, sitemap and OAuth redirects
NEXT_PUBLIC_SITE_URL=

# ── Demo seed (npm run seed) ─────────────────────────────────────────────────
DEMO_USER_EMAIL=demo@blwb.app
DEMO_USER_PASSWORD=
