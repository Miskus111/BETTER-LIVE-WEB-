{
  "name": "better-live-biohacking",
  "version": "0.6.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:data": "tsx --tsconfig scripts/tsconfig.json scripts/check-data.ts",
    "gen:placeholders": "tsx --tsconfig scripts/tsconfig.json scripts/gen-placeholders.tsx",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "images:todo": "tsx --tsconfig scripts/tsconfig.json scripts/images-todo.ts",
    "check:links": "tsx --tsconfig scripts/tsconfig.json scripts/check-links.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "review:doc": "tsx --tsconfig scripts/tsconfig.json scripts/medical-review.ts",
    "foods:build": "NODE_OPTIONS=--max-old-space-size=4096 tsx --tsconfig scripts/tsconfig.json scripts/foods/build.ts && npm run -s gen:picks",
    "foods:validate": "tsx --tsconfig scripts/tsconfig.json scripts/foods/validate.ts",
    "check:sources": "tsx --tsconfig scripts/tsconfig.json scripts/check-sources.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:data && npm run foods:validate && npm run test:e2e",
    "gen:picks": "tsx --tsconfig scripts/tsconfig.json scripts/gen-food-picks.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "4.14.1",
    "docx": "^9.16.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "@swc/core": true,
    "fsevents": true
  }
}
