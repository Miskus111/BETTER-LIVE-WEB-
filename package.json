{
  "name": "better-live-biohacking",
  "version": "0.4.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:data": "tsx --tsconfig scripts/tsconfig.json scripts/check-data.ts",
    "gen:placeholders": "tsx --tsconfig scripts/tsconfig.json scripts/gen-placeholders.tsx",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "images:todo": "tsx --tsconfig scripts/tsconfig.json scripts/images-todo.ts",
    "check:links": "tsx --tsconfig scripts/tsconfig.json scripts/check-links.ts",
    "gen:seed": "tsx --tsconfig scripts/tsconfig.json scripts/gen-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "tsx --tsconfig scripts/tsconfig.json scripts/seed-demo.ts",
    "test:rls": "tsx --tsconfig scripts/tsconfig.json scripts/test-rls.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "15.5.29",
    "next-intl": "^4.15.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
